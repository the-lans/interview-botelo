          "target_role": {
            "type": "string",
            "maxLength": 255,
            "minLength": 2,
            "title": "Target Role"
          },
          "level": {
            "type": "string",
            "enum": [
              "Junior",
              "Junior+",
              "Middle",
              "Middle+",
              "Senior"
            ],
            "title": "Level"
          },
          "horizon_weeks": {
            "type": "integer",
            "enum": [
              2,
              4,
              6
            ],
            "title": "Horizon Weeks"
          },
          "time_availability": {
            "$ref": "#/components/schemas/TimeAvailabilityIn"
          },
          "plan_format": {
            "type": "string",
            "enum": [
              "themes",
              "themes+practice",
              "themes+practice+mock_interview"
